rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number == userId);

      match /notifications/{notificationId} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.phone_number == userId);
        allow write: if true; // Written securely by Admin SDK or backend
      }
    }
  }
}
