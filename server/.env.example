# PayFlow Backend Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Project Configuration & Service Account Credentials
FIREBASE_PROJECT_ID=payflow-dev-4fd8d
# Absolute path to the downloaded Firebase service account JSON key file
# e.g., Windows: C:\Users\Username\payflow-app\server\serviceAccountKey.json
# e.g., macOS/Linux: /home/username/payflow-app/server/serviceAccountKey.json
# Required for auth.createCustomToken() to cryptographically sign custom tokens
GOOGLE_APPLICATION_CREDENTIALS=

# Dev Feature Flags (Off by default in production)
ALLOW_DEV_ENDPOINTS=false
# Only set to true if you explicitly want to mint fake mock_custom_tokens during offline testing (bypasses Firebase Auth)
ALLOW_MOCK_TOKENS=false

# CORS Allowed Origins (Comma-separated origins for production e.g. https://app.payflow.com)
CORS_ALLOWED_ORIGINS=

# External Payment Provider Secrets (Keep private, never commit .env)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=

# Webhook Cryptographic Verification Secrets
PAYSTACK_WEBHOOK_SECRET=
VTPASS_WEBHOOK_SECRET=

# Termii OTP Provider Configuration
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_BASE_URL=https://api.ng.termii.com

# Dojah KYC Identity Provider
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://sandbox.dojah.io

